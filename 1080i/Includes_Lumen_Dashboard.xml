<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lumen app dashboard (home screen).
    Shown by Home.xml unless Skin.HasSetting(Lumen.ClassicHome) brings back the Arctic Fuse 3 home.

    Controls
        9000  Up next row (Skin.String(Lumen.UpNext.Path), default POV Next Episodes)
        9100  App tiles, 6 x 2

    Tiles whose action lives outside Kodi (YouTube, YouTube TV, Photos, Browser) run
    Skin.String(Lumen.Action.<Name>) when set, else the HTPC launcher default below.
    Tile art is generated by .github/art/make_tiles.py into media/lumen/.
-->
<includes>
    <variable name="Lumen_UpNext_Path">
        <value condition="!String.IsEmpty(Skin.String(Lumen.UpNext.Path))">$INFO[Skin.String(Lumen.UpNext.Path)]</value>
        <value>plugin://plugin.video.pov/?mode=build_next_episode</value>
    </variable>

    <variable name="Lumen_UpNext_Title">
        <value condition="!String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
        <value>$INFO[ListItem.Title]</value>
    </variable>

    <variable name="Lumen_UpNext_Subtitle">
        <!-- Episode titles from POV carry date and colour tags, so build the line from clean fields. -->
        <value condition="!String.IsEmpty(ListItem.Episode)">$INFO[ListItem.Season,S]$INFO[ListItem.Episode, E]$INFO[ListItem.Duration(mins), · , min]</value>
        <value condition="Integer.IsGreater(ListItem.PercentPlayed,0)">$INFO[ListItem.PercentPlayed,,% watched]</value>
        <value>$INFO[ListItem.Year]</value>
    </variable>

    <include name="Lumen_Dashboard_Action">
        <!-- An external-app tile: a skin string override, else the launcher default. -->
        <onclick condition="!String.IsEmpty(Skin.String(Lumen.Action.$PARAM[name]))">$INFO[Skin.String(Lumen.Action.$PARAM[name])]</onclick>
        <onclick condition="String.IsEmpty(Skin.String(Lumen.Action.$PARAM[name]))">$PARAM[default]</onclick>
    </include>

    <!-- Layouts sit 30/25 px inside their item so the 110% focus zoom, ring and shadow aren't clipped by the panel. -->
    <include name="Lumen_Dashboard_Tile">
        <definition>
            <control type="group">
                <left>30</left>
                <top>25</top>
                <width>264</width>
                <height>149</height>
                <animation effect="zoom" start="100" end="110" center="132,74" time="180" tween="cubic" easing="out" condition="$PARAM[focused] + Control.HasFocus(9100)">Conditional</animation>
                <control type="image">
                    <left>-30</left>
                    <top>-30</top>
                    <width>324</width>
                    <height>208</height>
                    <texture>lumen/tile-shadow.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
                </control>
                <control type="image">
                    <left>-4</left>
                    <top>-4</top>
                    <width>272</width>
                    <height>157</height>
                    <texture>lumen/tile-focus.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
                </control>
                <control type="image">
                    <width>264</width>
                    <height>149</height>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </control>
            <control type="label">
                <left>30</left>
                <top>191</top>
                <width>264</width>
                <height>30</height>
                <font>font_mini_bold</font>
                <align>center</align>
                <textcolor>FFF4F5F7</textcolor>
                <label>$INFO[ListItem.Label]</label>
                <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
            </control>
        </definition>
    </include>

    <include name="Lumen_Dashboard">
        <control type="group">
            <control type="image">
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FF0A0C10">common/white.png</texture>
            </control>

            <!-- Header: wordmark and clock -->
            <control type="image">
                <left>80</left>
                <top>51</top>
                <width>14</width>
                <height>14</height>
                <texture colordiffuse="FFF5C46B">diffuse/circle/circle_120.png</texture>
            </control>
            <control type="label">
                <left>106</left>
                <top>33</top>
                <width>400</width>
                <height>50</height>
                <font>font_main_bold</font>
                <textcolor>FFF4F5F7</textcolor>
                <label>Lumen</label>
            </control>
            <control type="label">
                <right>80</right>
                <top>33</top>
                <width>400</width>
                <height>50</height>
                <font>font_main_bold</font>
                <align>right</align>
                <textcolor>FFF4F5F7</textcolor>
                <label>$INFO[System.Time]</label>
            </control>

            <!-- Up next -->
            <control type="label">
                <left>80</left>
                <top>118</top>
                <width>1200</width>
                <height>40</height>
                <font>font_main_bold</font>
                <textcolor>FFA3A9B4</textcolor>
                <label>Up next</label>
            </control>
            <control type="list" id="9000">
                <left>56</left>
                <top>150</top>
                <width>1864</width>
                <height>350</height>
                <orientation>horizontal</orientation>
                <onup>noop</onup>
                <ondown>9100</ondown>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <focusposition>0</focusposition>
                <movement>2</movement>
                <itemlayout width="440" height="350">
                    <include content="Lumen_UpNext_Card">
                        <param name="focused">false</param>
                    </include>
                </itemlayout>
                <focusedlayout width="440" height="350">
                    <include content="Lumen_UpNext_Card">
                        <param name="focused">true</param>
                    </include>
                </focusedlayout>
                <content target="videos">$VAR[Lumen_UpNext_Path]</content>
            </control>

            <!-- App tiles -->
            <control type="panel" id="9100">
                <left>50</left>
                <top>540</top>
                <width>1850</width>
                <height>480</height>
                <orientation>vertical</orientation>
                <onup>9000</onup>
                <ondown>noop</ondown>
                <scrolltime>0</scrolltime>
                <itemlayout width="299" height="204">
                    <include content="Lumen_Dashboard_Tile">
                        <param name="focused">false</param>
                    </include>
                </itemlayout>
                <focusedlayout width="299" height="204">
                    <include content="Lumen_Dashboard_Tile">
                        <param name="focused">true</param>
                    </include>
                </focusedlayout>
                <content>
                    <item>
                        <label>POV</label>
                        <icon>lumen/tiles/pov.png</icon>
                        <onclick>ActivateWindow(Videos,plugin://plugin.video.pov/,return)</onclick>
                    </item>
                    <item>
                        <label>Umbrella</label>
                        <icon>lumen/tiles/umbrella.png</icon>
                        <onclick>ActivateWindow(Videos,plugin://plugin.video.umbrella/,return)</onclick>
                    </item>
                    <item>
                        <label>YouTube</label>
                        <icon>lumen/tiles/youtube.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">YouTube</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_youtube.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>YouTube TV</label>
                        <icon>lumen/tiles/youtube-tv.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">YouTubeTV</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_youtube_tv.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Live TV</label>
                        <icon>lumen/tiles/livetv.png</icon>
                        <onclick>ActivateWindow(TVChannels)</onclick>
                    </item>
                    <item>
                        <label>Movies</label>
                        <icon>lumen/tiles/movies.png</icon>
                        <onclick>ActivateWindow(Videos,videodb://movies/titles/,return)</onclick>
                    </item>
                    <item>
                        <label>TV Shows</label>
                        <icon>lumen/tiles/tvshows.png</icon>
                        <onclick>ActivateWindow(Videos,videodb://tvshows/titles/,return)</onclick>
                    </item>
                    <item>
                        <label>Music</label>
                        <icon>lumen/tiles/music.png</icon>
                        <onclick>ActivateWindow(Music,musicdb://artists/,return)</onclick>
                    </item>
                    <item>
                        <label>Photos</label>
                        <icon>lumen/tiles/photos.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">Photos</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_photos.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Browser</label>
                        <icon>lumen/tiles/browser.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">Browser</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_browser.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Settings</label>
                        <icon>lumen/tiles/settings.png</icon>
                        <onclick>ActivateWindow(Settings)</onclick>
                    </item>
                    <item>
                        <label>Power</label>
                        <icon>lumen/tiles/power.png</icon>
                        <onclick>ActivateWindow(ShutdownMenu)</onclick>
                    </item>
                </content>
            </control>
        </control>
    </include>

    <!-- Offset 24/20 px inside the item, like the tiles, so the focus zoom and ring aren't clipped. -->
    <include name="Lumen_UpNext_Card">
        <definition>
            <control type="group">
                <left>24</left>
                <top>20</top>
                <width>408</width>
                <height>229</height>
                <animation effect="zoom" start="100" end="105" center="204,115" time="180" tween="cubic" easing="out" condition="$PARAM[focused] + Control.HasFocus(9000)">Conditional</animation>
                <control type="image">
                    <left>-4</left>
                    <top>-4</top>
                    <width>416</width>
                    <height>237</height>
                    <texture>lumen/tile-focus.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9000)</visible>
                </control>
                <control type="image">
                    <width>408</width>
                    <height>229</height>
                    <texture colordiffuse="FF161A21" diffuse="lumen/mask-16x9.png">common/white.png</texture>
                </control>
                <control type="image">
                    <width>408</width>
                    <height>229</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="lumen/mask-16x9.png" background="true">$INFO[ListItem.Art(thumb)]</texture>
                </control>
                <control type="progress">
                    <left>16</left>
                    <top>213</top>
                    <width>376</width>
                    <height>6</height>
                    <texturebg colordiffuse="55FFFFFF">common/white.png</texturebg>
                    <midtexture colordiffuse="FFF5C46B">common/white.png</midtexture>
                    <info>ListItem.PercentPlayed</info>
                    <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                </control>
            </control>
            <control type="label">
                <left>24</left>
                <top>263</top>
                <width>408</width>
                <height>34</height>
                <font>font_mini_bold</font>
                <textcolor>FFF4F5F7</textcolor>
                <label>$VAR[Lumen_UpNext_Title]</label>
            </control>
            <control type="label">
                <left>24</left>
                <top>297</top>
                <width>408</width>
                <height>30</height>
                <font>font_tiny</font>
                <textcolor>FFA3A9B4</textcolor>
                <label>$VAR[Lumen_UpNext_Subtitle]</label>
            </control>
        </definition>
    </include>
</includes>
