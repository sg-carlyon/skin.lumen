<?xml version="1.0" encoding="UTF-8"?>
<timers>
    <timer>
        <name>splashtest_autotime</name>
        <description>Advance the splash preview by one hour every three seconds.</description>
        <!-- Timers are loaded directly, without the includes expression expansion pass. -->
        <start reset="true">Window.IsVisible(1191) + String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true)</start>
        <stop>!Window.IsVisible(1191) | !String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(splashtest_autotime),3)</stop>
        <onstop condition="Window.IsVisible(1191) + String.IsEqual(Window(1191).Property(SplashTest.AutoTime),true)">SetProperty(SplashTest.Hour,$VAR[Value_StartUp_Test_NextHour],1191)</onstop>
    </timer>
    <timer>
        <name>lumen_shelf</name>
        <description>Lumen dashboard: switch the top row to the selected tile once the selection has rested for a second, so scrolling past tiles doesn't queue a load for each one.</description>
        <start reset="true">Window.IsActive(Home) + !String.IsEqual(Window(Home).Property(Lumen.ShelfTile),Container(9100).ListItem.Label)</start>
        <stop>!Window.IsActive(Home) | Integer.IsGreaterOrEqual(Skin.TimerElapsedSecs(lumen_shelf),1)</stop>
        <onstop condition="Window.IsActive(Home)">SetProperty(Lumen.ShelfPath,$INFO[Container(9100).ListItem.Property(shelf)],Home)</onstop>
        <onstop condition="Window.IsActive(Home)">SetProperty(Lumen.ShelfLabel,$INFO[Container(9100).ListItem.Property(shelflabel)],Home)</onstop>
        <onstop condition="Window.IsActive(Home)">SetProperty(Lumen.ShelfNote,$INFO[Container(9100).ListItem.Property(shelfnote)],Home)</onstop>
        <onstop condition="Window.IsActive(Home)">SetProperty(Lumen.ShelfTile,$INFO[Container(9100).ListItem.Label],Home)</onstop>
    </timer>
</timers>
