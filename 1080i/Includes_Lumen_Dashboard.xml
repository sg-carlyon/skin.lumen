<?xml version="1.0" encoding="UTF-8"?>
<!--
    Lumen app dashboard (home screen).
    Shown by Home.xml unless Skin.HasSetting(Lumen.ClassicHome) brings back the Arctic Fuse 3 home.

    Controls
        9000  Top row ("Top Shelf"). Its content follows the selected tile in 9100, about a
              second after the selection rests (lumen_shelf timer in Timers.xml):
              each tile item sets the properties shelf (path), shelflabel and shelfnote.
              A tile without a shelf shows Up next. Every row uses wide 16:9 cards.
        9100  App tiles, 6 x 2

    Background: "app glow". A soft light in the selected tile's colour sits behind the top
    right of the screen and cross-fades as the selection moves (one tinted glow.png per tile;
    only the visible one is drawn, so it costs almost nothing).

    Tiles whose action lives outside Kodi (YouTube, YouTube TV, Photos, Browser) run
    Skin.String(Lumen.Action.<Name>) when set, else the HTPC launcher default below.
    Tile art and textures are generated by .github/art/make_tiles.py into media/lumen/.
-->
<includes>
    <!-- Top row -->
    <variable name="Lumen_UpNext_Path">
        <value condition="!String.IsEmpty(Skin.String(Lumen.UpNext.Path))">$INFO[Skin.String(Lumen.UpNext.Path)]</value>
        <value>plugin://plugin.video.pov/?mode=build_next_episode</value>
    </variable>

    <!-- The lumen_shelf timer (Timers.xml) copies the selected tile's shelf properties into these
         Home window properties once the selection rests, debouncing the top row's loads. -->
    <variable name="Lumen_Shelf_Path">
        <value condition="!String.IsEmpty(Window(Home).Property(Lumen.ShelfPath))">$INFO[Window(Home).Property(Lumen.ShelfPath)]</value>
        <value>$VAR[Lumen_UpNext_Path]</value>
    </variable>

    <variable name="Lumen_Shelf_Label">
        <value condition="!String.IsEmpty(Window(Home).Property(Lumen.ShelfLabel))">$INFO[Window(Home).Property(Lumen.ShelfLabel)]</value>
        <value>Up next</value>
    </variable>

    <variable name="Lumen_Card_Art">
        <value condition="String.IsEqual(ListItem.DBType,episode) + !String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(landscape))">$INFO[ListItem.Art(landscape)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(fanart))">$INFO[ListItem.Art(fanart)]</value>
        <value condition="!String.IsEmpty(ListItem.Art(thumb))">$INFO[ListItem.Art(thumb)]</value>
        <value>$INFO[ListItem.Icon]</value>
    </variable>

    <variable name="Lumen_Card_Title">
        <value condition="!String.IsEmpty(ListItem.ChannelName)">$INFO[ListItem.ChannelName]</value>
        <value condition="!String.IsEmpty(ListItem.TVShowTitle)">$INFO[ListItem.TVShowTitle]</value>
        <value condition="!String.IsEmpty(ListItem.Artist) + String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Album]</value>
        <value condition="!String.IsEmpty(ListItem.Title)">$INFO[ListItem.Title]</value>
        <value>$INFO[ListItem.Label]</value>
    </variable>

    <variable name="Lumen_Card_Subtitle">
        <value condition="!String.IsEmpty(ListItem.ChannelName)">$INFO[ListItem.Title]</value>
        <!-- Episode titles from POV carry date and colour tags, so build the line from clean fields. -->
        <value condition="!String.IsEmpty(ListItem.Episode)">$INFO[ListItem.Season,S]$INFO[ListItem.Episode, E]$INFO[ListItem.Duration(mins), · , min]</value>
        <value condition="String.IsEqual(ListItem.DBType,album)">$INFO[ListItem.Artist]</value>
        <value condition="Integer.IsGreater(ListItem.PercentPlayed,0)">$INFO[ListItem.PercentPlayed,,% watched]</value>
        <value>$INFO[ListItem.Year]</value>
    </variable>

    <!-- App glow: one tinted layer per tile, faded in while that tile is selected -->
    <include name="Lumen_Glow">
        <control type="image">
            <left>860</left>
            <top>-560</top>
            <width>1500</width>
            <height>1250</height>
            <texture colordiffuse="$PARAM[color]">lumen/glow.png</texture>
            <visible>String.IsEqual(Container(9100).ListItem.Label,$PARAM[tile])</visible>
            <animation effect="fade" start="0" end="100" time="450" tween="sine" easing="out">Visible</animation>
            <animation effect="fade" start="100" end="0" time="450" tween="sine" easing="in">Hidden</animation>
        </control>
    </include>

    <include name="Lumen_Dashboard_Action">
        <!-- An external-app tile: a skin string override, else the launcher default. -->
        <onclick condition="!String.IsEmpty(Skin.String(Lumen.Action.$PARAM[name]))">$INFO[Skin.String(Lumen.Action.$PARAM[name])]</onclick>
        <onclick condition="String.IsEmpty(Skin.String(Lumen.Action.$PARAM[name]))">$PARAM[default]</onclick>
    </include>

    <include name="Lumen_Dashboard">
        <control type="group">
            <control type="image">
                <width>1920</width>
                <height>1080</height>
                <texture colordiffuse="FF0A0C10">common/white.png</texture>
            </control>

            <!-- App glow, in each tile's colour -->
            <control type="group">
                <include content="Lumen_Glow"><param name="tile">POV</param><param name="color">A04A3AB0</param></include>
                <include content="Lumen_Glow"><param name="tile">Umbrella</param><param name="color">A08A1E2A</param></include>
                <include content="Lumen_Glow"><param name="tile">YouTube</param><param name="color">A0981426</param></include>
                <include content="Lumen_Glow"><param name="tile">YouTube TV</param><param name="color">A0782020</param></include>
                <include content="Lumen_Glow"><param name="tile">Live TV</param><param name="color">A0217A8F</param></include>
                <include content="Lumen_Glow"><param name="tile">My Library</param><param name="color">A0345FA8</param></include>
                <include content="Lumen_Glow"><param name="tile">Favourites</param><param name="color">A08A6614</param></include>
                <include content="Lumen_Glow"><param name="tile">Music</param><param name="color">A0682E7A</param></include>
                <include content="Lumen_Glow"><param name="tile">Photos</param><param name="color">A05A6890</param></include>
                <include content="Lumen_Glow"><param name="tile">Browser</param><param name="color">A0285A8A</param></include>
                <include content="Lumen_Glow"><param name="tile">Settings</param><param name="color">A0465064</param></include>
                <include content="Lumen_Glow"><param name="tile">Power</param><param name="color">A07A3226</param></include>
            </control>

            <!-- Header: wordmark and clock -->
            <control type="image">
                <left>80</left>
                <top>51</top>
                <width>14</width>
                <height>14</height>
                <texture colordiffuse="FFF5C46B">diffuse/circle/circle_120.png</texture>
            </control>
            <control type="label">
                <left>106</left>
                <top>33</top>
                <width>400</width>
                <height>50</height>
                <font>font_main_bold</font>
                <textcolor>FFF4F5F7</textcolor>
                <shadowcolor>80000000</shadowcolor>
                <label>Lumen</label>
            </control>
            <control type="label">
                <right>80</right>
                <top>33</top>
                <width>400</width>
                <height>50</height>
                <font>font_main_bold</font>
                <align>right</align>
                <textcolor>FFF4F5F7</textcolor>
                <shadowcolor>80000000</shadowcolor>
                <label>$INFO[System.Time]</label>
            </control>

            <!-- Top row heading -->
            <control type="grouplist">
                <left>80</left>
                <top>112</top>
                <width>1600</width>
                <height>44</height>
                <orientation>horizontal</orientation>
                <itemgap>14</itemgap>
                <control type="label">
                    <width>auto</width>
                    <height>44</height>
                    <font>font_main_bold</font>
                    <textcolor>FFF4F5F7</textcolor>
                    <shadowcolor>80000000</shadowcolor>
                    <label>$VAR[Lumen_Shelf_Label]</label>
                </control>
                <control type="label">
                    <width>auto</width>
                    <height>44</height>
                    <aligny>center</aligny>
                    <font>font_tiny</font>
                    <textcolor>FFC2C8D1</textcolor>
                    <shadowcolor>80000000</shadowcolor>
                    <label>$INFO[Window(Home).Property(Lumen.ShelfNote)]</label>
                </control>
            </control>

            <!-- Top row -->
            <control type="list" id="9000">
                <left>56</left>
                <top>150</top>
                <width>1864</width>
                <height>350</height>
                <orientation>horizontal</orientation>
                <onup>noop</onup>
                <ondown>9100</ondown>
                <scrolltime tween="cubic" easing="out">300</scrolltime>
                <focusposition>0</focusposition>
                <movement>2</movement>
                <itemlayout width="440" height="350">
                    <include content="Lumen_Landscape_Card">
                        <param name="focused">false</param>
                    </include>
                </itemlayout>
                <focusedlayout width="440" height="350">
                    <include content="Lumen_Landscape_Card">
                        <param name="focused">true</param>
                    </include>
                </focusedlayout>
                <content target="videos">$VAR[Lumen_Shelf_Path]</content>
            </control>

            <!-- App tiles -->
            <control type="panel" id="9100">
                <left>50</left>
                <top>540</top>
                <width>1850</width>
                <height>480</height>
                <orientation>vertical</orientation>
                <onup>9000</onup>
                <ondown>noop</ondown>
                <scrolltime>0</scrolltime>
                <itemlayout width="299" height="204">
                    <include content="Lumen_Dashboard_Tile">
                        <param name="focused">false</param>
                    </include>
                </itemlayout>
                <focusedlayout width="299" height="204">
                    <include content="Lumen_Dashboard_Tile">
                        <param name="focused">true</param>
                    </include>
                </focusedlayout>
                <content>
                    <item>
                        <label>POV</label>
                        <icon>lumen/tiles/pov.png</icon>
                        <onclick>ActivateWindow(Videos,plugin://plugin.video.pov/,return)</onclick>
                    </item>
                    <item>
                        <label>Umbrella</label>
                        <icon>lumen/tiles/umbrella.png</icon>
                        <property name="shelf">plugin://plugin.video.themoviedb.helper/?info=trending_week&amp;tmdb_type=movie</property>
                        <property name="shelflabel">Trending this week</property>
                        <onclick>ActivateWindow(Videos,plugin://plugin.video.umbrella/,return)</onclick>
                    </item>
                    <item>
                        <label>YouTube</label>
                        <icon>lumen/tiles/youtube.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">YouTube</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_youtube.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>YouTube TV</label>
                        <icon>lumen/tiles/youtube-tv.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">YouTubeTV</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_youtube_tv.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Live TV</label>
                        <icon>lumen/tiles/livetv.png</icon>
                        <property name="shelf">pvr://channels/tv/*</property>
                        <property name="shelflabel">On now</property>
                        <onclick>ActivateWindow(TVChannels)</onclick>
                    </item>
                    <item>
                        <label>My Library</label>
                        <icon>lumen/tiles/library.png</icon>
                        <property name="shelf">videodb://recentlyaddedmovies/</property>
                        <property name="shelflabel">Recently added</property>
                        <property name="shelfnote">on your NAS</property>
                        <onclick>ActivateWindow(Videos,library://video/,return)</onclick>
                    </item>
                    <item>
                        <label>Favourites</label>
                        <icon>lumen/tiles/favourites.png</icon>
                        <property name="shelf">favourites://</property>
                        <property name="shelflabel">Favourites</property>
                        <onclick>ActivateWindow(Favourites)</onclick>
                    </item>
                    <item>
                        <label>Music</label>
                        <icon>lumen/tiles/music.png</icon>
                        <property name="shelf">musicdb://recentlyaddedalbums/</property>
                        <property name="shelflabel">Recently added albums</property>
                        <onclick>ActivateWindow(Music,musicdb://artists/,return)</onclick>
                    </item>
                    <item>
                        <label>Photos</label>
                        <icon>lumen/tiles/photos.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">Photos</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_photos.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Browser</label>
                        <icon>lumen/tiles/browser.png</icon>
                        <include content="Lumen_Dashboard_Action">
                            <param name="name">Browser</param>
                            <param name="default">RunScript(special://profile/scripts/launch.py,launch_browser.sh)</param>
                        </include>
                    </item>
                    <item>
                        <label>Settings</label>
                        <icon>lumen/tiles/settings.png</icon>
                        <onclick>ActivateWindow(Settings)</onclick>
                    </item>
                    <item>
                        <label>Power</label>
                        <icon>lumen/tiles/power.png</icon>
                        <onclick>ActivateWindow(ShutdownMenu)</onclick>
                    </item>
                </content>
            </control>
        </control>
    </include>

    <!-- Layouts sit 30/25 px inside their item so the 110% focus zoom, ring and shadow aren't clipped by the panel. -->
    <include name="Lumen_Dashboard_Tile">
        <definition>
            <control type="group">
                <left>30</left>
                <top>25</top>
                <width>264</width>
                <height>149</height>
                <animation effect="zoom" start="100" end="110" center="132,74" time="180" tween="cubic" easing="out" condition="$PARAM[focused] + Control.HasFocus(9100)">Conditional</animation>
                <control type="image">
                    <left>-30</left>
                    <top>-30</top>
                    <width>324</width>
                    <height>208</height>
                    <texture>lumen/tile-shadow.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
                </control>
                <control type="image">
                    <left>-4</left>
                    <top>-4</top>
                    <width>272</width>
                    <height>157</height>
                    <texture>lumen/tile-focus.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
                </control>
                <control type="image">
                    <width>264</width>
                    <height>149</height>
                    <texture>$INFO[ListItem.Icon]</texture>
                </control>
            </control>
            <control type="label">
                <left>30</left>
                <top>191</top>
                <width>264</width>
                <height>30</height>
                <font>font_mini_bold</font>
                <align>center</align>
                <textcolor>FFF4F5F7</textcolor>
                <label>$INFO[ListItem.Label]</label>
                <visible>$PARAM[focused] + Control.HasFocus(9100)</visible>
            </control>
        </definition>
    </include>

    <!-- Top row cards. Offset 24/20 px inside the item, like the tiles, so the focus zoom and ring aren't clipped. -->
    <include name="Lumen_Landscape_Card">
        <definition>
            <control type="group">
                <left>24</left>
                <top>20</top>
                <width>408</width>
                <height>229</height>
                <animation effect="zoom" start="100" end="105" center="204,115" time="180" tween="cubic" easing="out" condition="$PARAM[focused] + Control.HasFocus(9000)">Conditional</animation>
                <control type="image">
                    <left>-4</left>
                    <top>-4</top>
                    <width>416</width>
                    <height>237</height>
                    <texture>lumen/tile-focus.png</texture>
                    <visible>$PARAM[focused] + Control.HasFocus(9000)</visible>
                </control>
                <control type="image">
                    <width>408</width>
                    <height>229</height>
                    <texture colordiffuse="FF161A21" diffuse="lumen/mask-16x9.png">common/white.png</texture>
                </control>
                <control type="image">
                    <width>408</width>
                    <height>229</height>
                    <aspectratio>scale</aspectratio>
                    <texture diffuse="lumen/mask-16x9.png" background="true">$VAR[Lumen_Card_Art]</texture>
                    <visible>String.IsEmpty(ListItem.ChannelName)</visible>
                </control>
                <!-- Channel logos keep their shape on a plain card. -->
                <control type="image">
                    <left>104</left>
                    <top>40</top>
                    <width>200</width>
                    <height>110</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Icon]</texture>
                    <visible>!String.IsEmpty(ListItem.ChannelName)</visible>
                </control>
                <control type="progress">
                    <left>16</left>
                    <top>213</top>
                    <width>376</width>
                    <height>6</height>
                    <texturebg colordiffuse="55FFFFFF">common/white.png</texturebg>
                    <midtexture colordiffuse="FFF5C46B">common/white.png</midtexture>
                    <info>ListItem.PercentPlayed</info>
                    <visible>Integer.IsGreater(ListItem.PercentPlayed,0)</visible>
                </control>
                <control type="progress">
                    <left>16</left>
                    <top>190</top>
                    <width>376</width>
                    <height>6</height>
                    <texturebg colordiffuse="33FFFFFF">common/white.png</texturebg>
                    <midtexture colordiffuse="FFC9CED6">common/white.png</midtexture>
                    <info>ListItem.Progress</info>
                    <visible>!String.IsEmpty(ListItem.ChannelName)</visible>
                </control>
            </control>
            <control type="label">
                <left>24</left>
                <top>263</top>
                <width>408</width>
                <height>34</height>
                <font>font_mini_bold</font>
                <textcolor>FFF4F5F7</textcolor>
                <shadowcolor>80000000</shadowcolor>
                <label>$VAR[Lumen_Card_Title]</label>
            </control>
            <control type="label">
                <left>24</left>
                <top>297</top>
                <width>408</width>
                <height>30</height>
                <font>font_tiny</font>
                <textcolor>FFC2C8D1</textcolor>
                <shadowcolor>80000000</shadowcolor>
                <label>$VAR[Lumen_Card_Subtitle]</label>
            </control>
        </definition>
    </include>
</includes>
